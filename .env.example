PROJECT_NAME="Scalable FastAPI Project"
DESCRIPTION="Core FastAPI application scaffold"
VERSION="0.1.0"
ENVIRONMENT="development"
DEBUG=true
LOG_LEVEL="INFO"

API_V1_PREFIX="/api/v1"
API_V2_PREFIX="/api/v2"
OPENAPI_URL="/api/openapi.json"
DOCS_URL="/docs"
REDOC_URL="/redoc"
DOCS_ENABLED=true

API_KEY="dev-secret-key"
AUTH_SECRET_KEY="dev-auth-secret-key-change-me-32-bytes"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=15
MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCK_MINUTES=15
PASSWORD_MIN_LENGTH=8
RATE_LIMIT_PER_MINUTE=120
REDIS_URL="redis://localhost:6379/0"
UPLOAD_DIR="uploads"
EXTERNAL_API_URL="https://api.github.com"
DATABASE_URL="sqlite:///./app.db"
AUTO_CREATE_TABLES=true
# PostgreSQL: DATABASE_URL="postgresql+psycopg://user:password@localhost:5432/app"
# MySQL:      DATABASE_URL="mysql+pymysql://user:password@localhost:3306/app"
ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

SERVER_HOST="127.0.0.1"
SERVER_PORT=8000
