ENVIRONMENT="testing"
DEBUG=false
LOG_LEVEL="WARNING"
DOCS_ENABLED=true
API_KEY="test-secret-key"
AUTH_SECRET_KEY="test-auth-secret-key-change-me-32-bytes"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
DATABASE_URL="sqlite:///./app.test.db"
AUTO_CREATE_TABLES=true
# PostgreSQL: DATABASE_URL="postgresql+psycopg://user:password@localhost:5432/app_test"
# MySQL:      DATABASE_URL="mysql+pymysql://user:password@localhost:3306/app_test"
ALLOWED_ORIGINS="http://testserver"
SERVER_HOST="127.0.0.1"
SERVER_PORT=8001
