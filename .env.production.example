ENVIRONMENT="production"
DEBUG=false
LOG_LEVEL="INFO"
DOCS_ENABLED=false
API_KEY="replace-with-a-secure-production-key"
AUTH_SECRET_KEY="replace-with-a-secure-production-auth-secret-key"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=15
MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCK_MINUTES=15
PASSWORD_MIN_LENGTH=12
RATE_LIMIT_PER_MINUTE=600
REDIS_URL="redis://redis:6379/0"
UPLOAD_DIR="/var/app/uploads"
EXTERNAL_API_URL="https://api.github.com"
DATABASE_URL="postgresql+psycopg://user:password@localhost:5432/app"
AUTO_CREATE_TABLES=false
# MySQL: DATABASE_URL="mysql+pymysql://user:password@localhost:3306/app"
ALLOWED_ORIGINS="https://example.com"
SERVER_HOST="0.0.0.0"
SERVER_PORT=8000
